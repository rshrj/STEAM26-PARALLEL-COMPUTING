# Makefile definitions.  Comment out the one
# you wish to use:

# gnu compiler for Linux (default on the academy laptops / lxplus, AlmaLinux 9).
# The system "gcc" already includes OpenMP; "module load gcc/16.1.0" gives a newer one.
CC          = gcc

# Intel Compiler
#CC          = icc

# On a Mac the default "gcc" is Apple clang, which has OpenMP removed. Install a
# real gnu compiler (e.g. via homebrew) and use its versioned name, e.g.:
#CC          = gcc-15

# These definitions should work on any system
CLINKER     = $(CC)
OPTFLAGS    = -std=c11 -fopenmp -O3 
LIBS        = -lm
PRE         = ./

CFLAGS	  = $(OPTFLAGS)

# Definitions for Linx and OSX.   We'd need to change these
# to support Windows with nmake
OBJ=o
EXE=
RM=rm
